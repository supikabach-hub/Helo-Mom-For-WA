<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_frame"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Area: Photo & Pagination Buttons (75% height) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="6dp">

        <!-- Contact Photo -->
        <ImageView
            android:id="@+id/img_contact_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#333333"
            android:contentDescription="Foto Kontak" />

        <!-- Left Arrow Button (<) -->
        <TextView
            android:id="@+id/btn_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_arrow_btn"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Right Arrow Button (>) -->
        <TextView
            android:id="@+id/btn_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_arrow_btn"
            android:gravity="center"
            android:text="&gt;"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Page Indicator Overlay at Top Right -->
        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_margin="8dp"
            android:background="#CC000000"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="1 dari 2"
            android:textColor="#D1A153"
            android:textSize="13sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Name Label -->
    <TextView
        android:id="@+id/tv_contact_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Anak Ke-1 (Budi)"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Separate Green WhatsApp Action Button (Bottom) -->
    <LinearLayout
        android:id="@+id/btn_call_wa"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_call_btn"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_action_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PANGGIL WA SEKARANG"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
